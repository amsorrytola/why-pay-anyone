# Copy to .env (git ignores .env) and fill in. Never commit real keys.
# Key for the site's chatbot (Google Gemini API). It is read only on the server.
GEMINI_API_KEY=
# Key for fetching OpenRouter's public rankings data (pipeline only, never used by the site).
OPENROUTER_API_KEY=
# Model for the chatbot. Check ai.google.dev/gemini-api/docs/pricing before changing it.
GEMINI_MODEL=gemini-3.1-flash-lite
