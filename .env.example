# Copy to .env (git ignores .env) and fill in. Never commit real keys.

# Chatbot (read only on the server). Answers stream; the chat tries Gemini 2.5 Flash, Gemini 2.5 Flash-Lite,
# MiniMax, then the newer Gemini model, skipping any that has not started answering by its deadline.
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3.1-Flash

# Pipeline only: OpenRouter's public rankings data (never used by the site).
OPENROUTER_API_KEY=

# Presentation only: the video's narration (Sarvam AI text-to-speech).
SARVAM_API_KEY=
